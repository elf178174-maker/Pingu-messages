<?xml version="1.0" encoding="utf-8"?>
<!--
  Pingu Messages — manifest.

  The four components Android requires from a default SMS application are marked with
  "[DEFAULT SMS ROLE]" below. All four must be present, exported, and guarded by the matching
  system permission or the app will not appear in Settings > Default apps > SMS app.
  See docs/ANDROID_NOTES.md for the full explanation.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Messaging. Granted at runtime; the SMS group is only requested once the user has asked
         to become the default SMS app, because Android hands the role and the permissions
         together. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />

    <!-- Contact names and photos for conversations. Optional: the app degrades to raw numbers. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SIM / subscription information for dual-SIM devices. Optional. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Voice messages. Requested the first time the user holds the microphone button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Saving an attachment into the public Downloads folder. Android 10 and later do this
         through MediaStore and need no permission, so the request only ever appears on 9 and
         below, and only when the user taps Save. Picking media needs nothing at all: the app uses
         the system photo picker and the document picker. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Location sharing. Requested only when the user taps "Location" in the attachment sheet. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Scheduled messages. SCHEDULE_EXACT_ALARM is requested through the system settings screen;
         if the user declines, scheduling falls back to inexact alarms plus a WorkManager sweep. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Network state is read to explain MMS failures ("no mobile data") accurately. The app never
         talks to a server of ours; MMS goes to the carrier MMSC through the platform. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- Package visibility (Android 11+): the app resolves these intents to enable or hide
         actions such as "Take photo", "Call" and "View contact". -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".PinguApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pingu.Starting"
        tools:targetApi="34">

        <!-- Single-window host for the whole Compose navigation graph. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Pingu.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- [DEFAULT SMS ROLE] 1/4 — an activity that can compose a message for sms:/mms: URIs. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <!-- Receiving shared content from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Conversation bubbles (Android 11+) and "open in new window" on large screens need an
             activity that can be launched into its own task/document. -->
        <activity
            android:name=".ui.ConversationWindowActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale"
            android:theme="@style/Theme.Pingu"
            android:windowSoftInputMode="adjustResize" />

        <!-- [DEFAULT SMS ROLE] 2/4 — quick-response service used by the phone app during a call. -->
        <service
            android:name=".platform.sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- [DEFAULT SMS ROLE] 3/4 — delivery of incoming SMS. Only the default SMS app receives
             SMS_DELIVER; every other app can at most observe SMS_RECEIVED. -->
        <receiver
            android:name=".platform.sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- [DEFAULT SMS ROLE] 4/4 — delivery of incoming MMS notifications (WAP push). -->
        <receiver
            android:name=".platform.mms.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Result callbacks for outgoing SMS/MMS (PendingIntents handed to SmsManager). -->
        <receiver
            android:name=".platform.sms.SmsStatusReceiver"
            android:exported="false" />
        <receiver
            android:name=".platform.mms.MmsStatusReceiver"
            android:exported="false" />

        <!-- Notification actions: inline reply, mark as read, mute, delete. -->
        <receiver
            android:name=".platform.notification.NotificationActionReceiver"
            android:exported="false" />

        <!-- Scheduled messages: exact alarm callback plus reboot/time-change rescheduling. -->
        <receiver
            android:name=".platform.scheduling.ScheduledMessageReceiver"
            android:exported="false" />
        <receiver
            android:name=".platform.scheduling.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: recent conversations, unread badge and a compose shortcut. -->
        <receiver
            android:name=".platform.widget.ConversationsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/conversations_widget_info" />
        </receiver>

        <service
            android:name=".platform.widget.ConversationsWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Attachments are handed to other apps (share, "open with") through a FileProvider so no
             file:// URI ever leaves the app and every grant is scoped and temporary. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager is initialised manually so the app can install its own configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>

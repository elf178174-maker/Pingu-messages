<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replacement for backup_rules.xml. Same policy; see that file for the rationale. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <exclude domain="database" path="pingu-messages.db" />
        <exclude domain="file" path="exports/" />
        <exclude domain="external" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <!-- Device-to-device transfer may carry the local mirror: it stays on the user's hardware. -->
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="pingu-messages.db" />
        <exclude domain="file" path="exports/" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

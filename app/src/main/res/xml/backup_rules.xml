<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup (Android 11 and below).

  An include list is exhaustive: anything not named here is not backed up, so the settings store is
  all that leaves the device. The message mirror is deliberately absent - messages live in the
  system telephony provider, which the platform backs up separately, and restoring a stale mirror
  would resurrect deleted threads. Caches, exported archives and external storage are absent for
  the same reason. Settings > Storage offers an explicit, user-driven export instead.
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
</full-backup-content>
